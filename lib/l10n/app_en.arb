  "privacyLastUpdated": "Last updated: July 2026",
  "privacyIntroBody": "MyBL is the official student portal of the Budi Luhur school ecosystem, managed by Yayasan Pakarti Luhur. This policy explains what data the app processes and how it is protected.",
  "privacyDataTitle": "Data We Process",
  "privacyDataBody": "The app displays academic data provided by the school system, such as your name, student number (NIS), class, attendance records, grades, schedules, extracurricular activities, merit/demerit points, and school notifications. The app does not collect data beyond what the school already manages.",
  "privacyUsageTitle": "How Data Is Used",
  "privacyUsageBody": "Your data is used solely to show your academic information inside the app and to deliver school notifications. It is never used for advertising or profiling.",
  "privacyStorageTitle": "Storage & Security",
  "privacyStorageBody": "Login credentials are never stored on the device. Access tokens are kept in encrypted secure storage, and academic data is cached locally only to speed up the app. All communication with school servers uses encrypted connections.",
  "privacyNotificationTitle": "Notifications",
  "privacyNotificationBody": "If you enable notifications, the app registers a device token with Firebase Cloud Messaging so the school can send you announcements and attendance updates. You can disable notifications at any time from your device settings.",
  "privacySharingTitle": "Data Sharing",
  "privacySharingBody": "Your data is not sold or shared with third parties. It is only exchanged between the app and official school servers. Parent accounts can only access data of their own children.",
  "privacyContactTitle": "Contact",
  "privacyContactBody": "For questions about this policy or requests regarding your data, contact the school through the Help Center.",
  "privacyPolicy": "Privacy Policy",
